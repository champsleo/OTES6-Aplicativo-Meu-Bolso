<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoNome"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/nome_conta">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLength="50" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ao criar mostra os botões de tipo; ao editar vira um texto fixo. -->
        <TextView
            android:id="@+id/tvTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tipo_desta_conta"
            android:textColor="@color/texto_secundario" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:checkedButton="@+id/btnCarteira"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCarteira"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tipo_carteira" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBanco"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tipo_banco" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCartao"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tipo_cartao" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoSaldo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/saldo_inicial"
            app:prefixText="@string/prefixo_moeda">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSaldo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvSaldoAtual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto_principal"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
